# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only needed for EVAL_MODE=record and EVAL_MODE=live.
# The default replay mode runs entirely from fixtures/ with NO key and NO network,
# which is how a grader is expected to run this repo.
GOOGLE_API_KEY=

# replay (default) | record | live
#   replay — no network. A fixture cache miss is a HARD ERROR, never a silent API call.
#   record — populate fixtures/ from the live API. Spends free-tier quota.
#   live   — always call the API. Used for the E8 flip-rate measurement only.
EVAL_MODE=replay
